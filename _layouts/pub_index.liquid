---
---
{%- assign link = entry.website | default: entry.html | default: entry.pdf -%}
{%- assign num = index | prepend: '0' | slice: -2, 2 -%}
<article class="entry" data-index="R{{ num }}" data-meta="{{ entry.year }}">
  {% if entry.preview %}
    <a class="thumbnail" href="{{ link }}" tabindex="-1" aria-hidden="true">
      <img src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}" alt="" loading="lazy">
    </a>
  {% else %}
    <span class="thumbnail"></span>
  {% endif %}
  <div class="entry-body">
    <h3>
      {%- if link -%}
        <a href="{{ link }}">{{ entry.title }}</a>
      {%- else -%}
        {{ entry.title }}
      {%- endif -%}
    </h3>
    <p class="authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
        {%- if site.scholar.last_name contains author_last and site.scholar.first_name contains author.first -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor -%}
    </p>
    <p class="venue">{{ entry.venue | default: entry.booktitle | default: entry.journal }}</p>
    {% if entry.also %}
      <p class="venue">{{ entry.also | markdownify | remove: '<p>' | remove: '</p>' | strip }}</p>
    {% endif %}
    <p class="entry-links">
      {%- capture links -%}
        {%- if entry.website %}<a href="{{ entry.website }}">Webpage</a>|{% endif -%}
        {%- if entry.html %}<a href="{{ entry.html }}">Paper</a>|{% endif -%}
        {%- if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>|{% endif -%}
        {%- if entry.pdf %}<a href="{{ entry.pdf }}">PDF</a>|{% endif -%}
        {%- if entry.code %}<a href="{{ entry.code }}">Code</a>|{% endif -%}
      {%- endcapture -%}
      {%- assign link_list = links | split: '|' -%}
      {%- for l in link_list -%}
        {{ l -}}
        {%- unless forloop.last -%}
          <span class="sep" aria-hidden="true">•</span>
        {%- endunless %}
      {%- endfor -%}
    </p>
  </div>
</article>

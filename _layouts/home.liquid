<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include site_head.liquid %}
  </head>
  <body>
    <main class="wrap">
      <header class="intro">
        <div class="intro-text">
          <h1>
            {{ site.first_name }}
            {% if site.middle_name %}{{ site.middle_name }} {% endif -%}
            {{- site.last_name }}
          </h1>

          {% assign bio_parts = content | split: '<!--more-->' %}
          <div class="bio">
            {% if bio_parts.size > 1 %}
              {% assign lead = bio_parts[0] | strip %}
              {% assign lead_len = lead | size | minus: 4 %}
              {{ lead | slice: 0, lead_len }}
              <button class="bio-toggle" type="button" aria-expanded="false" aria-controls="bio-more">More +</button>
              </p>
              <div class="bio-more" id="bio-more">
                {{ bio_parts[1] }}
              </div>
            {% else %}
              {{ content }}
            {% endif %}
          </div>

          <nav class="links">
            {% for link in page.links %}
              <a href="{{ link.url }}">{{ link.name }}</a>
            {% endfor %}
          </nav>

          <p class="contact">
            <span class="label">Contact</span>
            <a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a>
          </p>
        </div>

        {% if page.portraits and page.portraits.size > 0 %}
          <div class="portrait-stack" data-interval="{{ page.portrait_interval | default: 10 }}">
            {% for photo in page.portraits %}
              <img
                class="portrait{% if forloop.first %} is-active{% endif %}"
                src="{{ photo.src | prepend: '/assets/img/' | relative_url }}"
                alt="{{ photo.alt | default: 'Portrait of William Huang' }}"
                width="192"
                height="192"
                {% unless forloop.first %}
                  aria-hidden="true"
                {% endunless %}
              >
            {% endfor %}
          </div>
        {% endif %}
      </header>

      <section id="research" aria-label="Research">
        <div class="index-bar">
          <span class="label">Index</span>
          <span class="tab is-active"
            >Research <span class="count">{% bibliography_count --query @*[selected=true]* %}</span></span
          >
        </div>
        <div class="entries">
          {% bibliography --group_by none --query @*[selected=true]* --template pub_index %}
        </div>
      </section>

      <footer>Last updated {{ site.time | date: '%B %Y' }}.</footer>
    </main>

    <script>
      (function () {
        var btn = document.querySelector('.bio-toggle');
        var more = document.getElementById('bio-more');
        if (!btn || !more) return;
        btn.addEventListener('click', function () {
          var open = more.classList.toggle('open');
          btn.setAttribute('aria-expanded', open);
          btn.textContent = open ? 'Less −' : 'More +';
        });
      })();

      (function () {
        var stack = document.querySelector('.portrait-stack');
        if (!stack) return;
        var photos = stack.querySelectorAll('.portrait');
        if (photos.length < 2) return;
        var seconds = parseFloat(stack.getAttribute('data-interval')) || 10;
        var current = 0;
        setInterval(function () {
          photos[current].classList.remove('is-active');
          photos[current].setAttribute('aria-hidden', 'true');
          current = (current + 1) % photos.length;
          photos[current].classList.add('is-active');
          photos[current].removeAttribute('aria-hidden');
        }, seconds * 1000);
      })();
    </script>
  </body>
</html>

<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include site_head.liquid %}
  </head>
  <body>
    <main class="wrap">
      <header class="intro">
        <div class="intro-text">
          <h1>
            {{ site.first_name }}
            {% if site.middle_name %}{{ site.middle_name }} {% endif -%}
            {{- site.last_name }}
          </h1>

          {% assign bio_parts = content | split: '<!--more-->' %}
          <div class="bio">
            {% if bio_parts.size > 1 %}
              {% assign lead = bio_parts[0] | strip %}
              {% assign lead_len = lead | size | minus: 4 %}
              {{ lead | slice: 0, lead_len }}
              <button class="bio-toggle" type="button" aria-expanded="false" aria-controls="bio-more">More +</button>
              </p>
              <div class="bio-more" id="bio-more">
                {{ bio_parts[1] }}
              </div>
            {% else %}
              {{ content }}
            {% endif %}
          </div>

          <nav class="links">
            {% for link in page.links %}
              <a href="{{ link.url }}">{{ link.name }}</a>
            {% endfor %}
          </nav>

          <p class="contact">
            <span class="label">Contact</span>
            <a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a>
          </p>
        </div>

        {% if page.portrait %}
          <img
            class="portrait"
            src="{{ page.portrait | prepend: '/assets/img/' | relative_url }}"
            alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
            width="192"
            height="192"
          >
        {% endif %}
      </header>

      <section id="research" aria-label="Research">
        <div class="index-bar">
          <span class="label">Index</span>
          <span class="tab is-active"
            >Research <span class="count">{% bibliography_count --query @*[selected=true]* %}</span></span
          >
        </div>
        <div class="entries">
          {% bibliography --group_by none --query @*[selected=true]* --template pub_index %}
        </div>
      </section>

      <footer>Last updated {{ site.time | date: '%B %Y' }}.</footer>
    </main>

    <script>
      (function () {
        var btn = document.querySelector('.bio-toggle');
        var more = document.getElementById('bio-more');
        if (!btn || !more) return;
        btn.addEventListener('click', function () {
          var open = more.classList.toggle('open');
          btn.setAttribute('aria-expanded', open);
          btn.textContent = open ? 'Less −' : 'More +';
        });
      })();
    </script>
  </body>
</html>
